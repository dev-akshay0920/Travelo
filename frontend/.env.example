# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API (leave empty or point to the Express API once available).
# The frontend foundation runs without this being reachable.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Server-only secrets (do NOT prefix with NEXT_PUBLIC_).
# These are placeholders — never commit real credentials.
# DATABASE_URL=
# JWT_SECRET=
