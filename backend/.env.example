NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://localhost:27017/fdgfhgjhk

CLIENT_URL=http://localhost:3000

LOG_LEVEL=info

BODY_JSON_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

SESSION_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=travora_session

JWT_SECRET=change-me-to-a-secure-jwt-secret-at-least-32-chars
JWT_EXPIRY=7d

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Optional until agency profile image uploads are enabled.
# Configure all six variables together; never put access keys in the frontend.
# FILEBASE_ENDPOINT=https://s3.filebase.io
# FILEBASE_REGION=auto
# FILEBASE_BUCKET_NAME=<travora-profile-image-bucket>
# FILEBASE_ACCESS_KEY_ID=<backend-access-key-id>
# FILEBASE_SECRET_ACCESS_KEY=<backend-secret-access-key>
# FILEBASE_PUBLIC_BASE_URL=https://<bucket-name>.s3.filebase.io